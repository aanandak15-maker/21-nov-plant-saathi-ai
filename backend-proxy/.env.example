# Backend Proxy Environment Variables

# Google Earth Engine
GEE_PROJECT_ID=your-gee-project-id
GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"
GEE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# OpenWeather API
OPENWEATHER_API_KEY=your-openweather-api-key

# Backend API Security (CRITICAL: Change in production!)
BACKEND_API_KEY=your-secure-random-api-key-here

# Server Configuration
PORT=3001
NODE_ENV=production
